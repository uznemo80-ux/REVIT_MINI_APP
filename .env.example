# ======================================================
# YOSHUZBEKK Academy — Environment Variables
# ======================================================

# PostgreSQL database URL (Railway)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Telegram Bot Token
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Asosiy Super Admin Telegram ID
ADMIN_TELEGRAM_ID=8043641301

# Mini App URL (Railway deployment URL)
APP_URL=https://your-app.up.railway.app

# Bunny Stream
BUNNY_LIBRARY_ID=123456
BUNNY_TOKEN_AUTH_KEY=your-bunny-token-auth-key

# Server port (Railway avtomatik beradi)
PORT=3000

# ======================================================
# AI Material Agent (Kutubxona → Materiallar avtomatik to'ldirish)
# ======================================================
# Gemini API kaliti (aistudio.google.com). Bepul rejimda billing shart emas.
GEMINI_API_KEY=
# Ixtiyoriy: rasmlar uchun yopiq Telegram kanal ID. Bo'sh bo'lsa rasmlar admin chatida saqlanadi.
MATERIAL_MEDIA_CHANNEL_ID=
# Qidiruv rejimi: off (bepul, brend saytlari sitemap'i) | google (Gemini paid tarif kerak)
# MATERIAL_AGENT_SEARCH=off
# Qo'shimcha brend saytlari (vergul bilan), asosiy ro'yxat admin paneldagi ishlab chiqaruvchilar
# MATERIAL_AGENT_SITES=https://example.uz
# Ixtiyoriy: model nomi (bo'sh — avtomatik tanlanadi), ishga tushish soati, haftalik limit, o'chirish
# GEMINI_MODEL=
# MATERIAL_AGENT_HOUR=12
# MATERIAL_AGENT_WEEKLY_LIMIT=2
# MATERIAL_AGENT_ENABLED=true
# Rasm tuzatuvchi (botda /rasmlar bilan yoqiladi): soatiga nechta material, kuniga maksimum
# MATERIAL_IMAGE_REPAIR_BATCH=12
# MATERIAL_IMAGE_REPAIR_DAILY=120
