# BotFather'dan olingan token
BOT_TOKEN=your_bot_token_here

# Railway avtomatik beradi (Postgres qo'shsangiz)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Sizning shaxsiy Telegram ID'ingiz (admin) - @userinfobot orqali bilib olasiz
ADMIN_TELEGRAM_ID=123456789

# Mini App qaysi domenda ochiladi (Railway bergan domen)
APP_URL=https://your-app.up.railway.app

PORT=3000
