  "description": "YOSHUZBEKK Academy — Telegram Mini App",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "bot": "node bot.js",
    "check": "node --check server.js && node --check bot.js && node --check public/app.js && for f in services/materialAgent/*.js; do node --check $f || exit 1; done && echo OK",
